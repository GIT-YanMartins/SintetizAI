          }
        ]
      ]
    },
    "Gerar Resumo via API FastAPI": {
      "main": [
        [
          {
            "node": "Classificar Urgência (IF)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Classificar Urgência (IF)": {
      "main": [
        [
          {
            "node": "Preparar Alerta Prioritário",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Preparar Resumo Padrão",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar Alerta Prioritário": {
      "main": [
        [
          {
            "node": "Responder Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar Resumo Padrão": {
      "main": [
        [
          {
            "node": "Responder Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveExecutionProgress": true
  },
  "tags": []
