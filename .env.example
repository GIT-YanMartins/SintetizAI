# Chave da API do Google Gemini (obtenha no Google AI Studio)
GEMINI_API_KEY=sua_chave_api_aqui
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.5-flash-lite

# Configurações da API FastAPI
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development

# URL do Webhook do fluxo de automação no n8n (opcional para disparo via interface)
AUTOMATION_WEBHOOK_URL=http://localhost:5678/webhook/resumir-texto
