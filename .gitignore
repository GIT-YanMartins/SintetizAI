dados/*.json
!dados/.gitkeep
*.sqlite
*.db

# Configurações e banco local do n8n
.n8n/
.n8n_local/

# Logs e arquivos de sistema
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
